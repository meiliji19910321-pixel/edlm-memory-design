{
  "env": {
    "MEMORY_PATH": "D:\\CLAUDE.MD",
    "PYTHONPATH": "D:\\CLAUDE.MD"
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "pwsh -NoProfile -Command \"$me = if (Test-Path 'D:\\CLAUDE.MD\\memory\\me.md') { Get-Content 'D:\\CLAUDE.MD\\memory\\me.md' -Raw } else { '' }; $core = if (Test-Path 'D:\\CLAUDE.MD\\memory\\core.md') { Get-Content 'D:\\CLAUDE.MD\\memory\\core.md' -Raw } else { '' }; $brief = if (Test-Path 'D:\\CLAUDE.MD\\memory\\briefing\\current.md') { Get-Content 'D:\\CLAUDE.MD\\memory\\briefing\\current.md' -Raw } else { '' }; Write-Output ('SESSION_MEMORY|' + $me + '|END_ME|' + $core + '|END_CORE|' + $brief + '|END_BRIEF')\"",
            "timeout": 30,
            "statusMessage": "加载记忆上下文..."
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "pwsh -NoProfile -Command \"& python 'D:\\CLAUDE.MD\\projects\\edlm-memory-framework\\edlm_memory\\edlm_memory.py' rotate\"",
            "timeout": 60,
            "statusMessage": "执行记忆衰减检查..."
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "pwsh -NoProfile -Command \"& python 'D:\\CLAUDE.MD\\projects\\edlm-memory-framework\\edlm_memory\\briefing_generator.py'\"",
            "timeout": 30,
            "statusMessage": "保存会话摘要..."
          }
        ]
      }
    ]
  }
}
